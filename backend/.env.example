PORT=4000
# Comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,https://your-portfolio.vercel.app
RESEND_API_KEY=
RESEND_TO_EMAIL=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Admin login (uploads, profile photo, messages)
ADMIN_USERNAME=admin
# npm run hash-password -- '<your password>'   (keep the single quotes in this file)
ADMIN_PASSWORD_HASH='scrypt$...$...'
# Random 32+ characters, e.g. openssl rand -hex 32. Changing it logs the admin out everywhere.
SESSION_SECRET=
# Production storage (Vercel dashboard → Storage → Blob). Leave empty locally to save to ./uploads
BLOB_READ_WRITE_TOKEN=
