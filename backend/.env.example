PORT=4000
# Comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,https://your-portfolio.vercel.app
RESEND_API_KEY=
RESEND_TO_EMAIL=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Image upload: callers must send "Authorization: Bearer <UPLOAD_TOKEN>"
UPLOAD_TOKEN=
# Production storage (Vercel dashboard → Storage → Blob). Leave empty locally to save to ./uploads
BLOB_READ_WRITE_TOKEN=
