{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "Stack", "Effect": "Allow", "Action": "cloudformation:*",
      "Resource": "arn:aws:cloudformation:us-east-1:579498208331:stack/portfolio-backend/*" },
    { "Sid": "TemplateChecks", "Effect": "Allow",
      "Action": ["cloudformation:ValidateTemplate", "cloudformation:GetTemplateSummary"], "Resource": "*" },
    { "Sid": "Function", "Effect": "Allow", "Action": "lambda:*",
      "Resource": "arn:aws:lambda:us-east-1:579498208331:function:portfolio-backend" },
    { "Sid": "Bucket", "Effect": "Allow", "Action": "s3:*",
      "Resource": ["arn:aws:s3:::portfolio-uploads-579498208331-us-east-1", "arn:aws:s3:::portfolio-uploads-579498208331-us-east-1/*"] },
    { "Sid": "Role", "Effect": "Allow",
      "Action": ["iam:GetRole", "iam:CreateRole", "iam:DeleteRole", "iam:UpdateRole", "iam:UpdateAssumeRolePolicy",
                 "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:PutRolePolicy", "iam:DeleteRolePolicy",
                 "iam:GetRolePolicy", "iam:ListRolePolicies", "iam:ListAttachedRolePolicies",
                 "iam:TagRole", "iam:UntagRole"],
      "Resource": "arn:aws:iam::579498208331:role/portfolio-backend-us-east-1" },
    { "Sid": "PassRoleToLambda", "Effect": "Allow", "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::579498208331:role/portfolio-backend-us-east-1",
      "Condition": { "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" } } },
    { "Sid": "Logs", "Effect": "Allow",
      "Action": ["logs:FilterLogEvents", "logs:GetLogEvents", "logs:DescribeLogStreams", "logs:StartLiveTail"],
      "Resource": "arn:aws:logs:us-east-1:579498208331:log-group:/aws/lambda/portfolio-backend*" }
  ]
}
